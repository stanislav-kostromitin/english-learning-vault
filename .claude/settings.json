{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& { & (Join-Path $env:CLAUDE_PROJECT_DIR '.claude/hooks/check-duplicate-note.ps1'); exit $LASTEXITCODE }\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
